&FORCE_EVAL
   METHOD Quickstep
   STRESS_TENSOR ANALYTICAL
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT
      POTENTIAL_FILE_NAME POTENTIAL
      MULTIPLICITY 1
      &MGRID
         CUTOFF     400
         REL_CUTOFF 50
         NGRIDS     4
      &END MGRID
      &POISSON
         PERIODIC XYZ
      &END POISSON
      &QS
         METHOD GPW
      &END QS
      &SCF
         EPS_SCF 1.0E-6
         MAX_SCF 3000
         &OT
            MINIMIZER      CG
            PRECONDITIONER FULL_ALL
            ENERGY_GAP 1.0E-3
         &END OT
      &END SCF
      &XC
         &XC_FUNCTIONAL PBE
            &PBE
               PARAMETRIZATION ORIG
            &END PBE
         &END XC_FUNCTIONAL
         &VDW_POTENTIAL
            DISPERSION_FUNCTIONAL  PAIR_POTENTIAL
            &PAIR_POTENTIAL
               TYPE                 DFTD3
               PARAMETER_FILE_NAME  /software/sse/manual/CP2K/2023.1-gcc-11.3.0-bare/nsc1/data/dftd3.dat
               REFERENCE_FUNCTIONAL PBE
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
      &END XC
   &END DFT
   &SUBSYS
      &KIND Ag
         BASIS SET DZVP-MOLOPT-SR-GTH
         POTENTIAL GTH-PBE
      &END KIND
      &KIND Al
         BASIS SET DZVP-MOLOPT-SR-GTH
         POTENTIAL GTH-PBE
      &END KIND
